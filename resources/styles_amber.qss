/* ============================================
 * 贪吃蛇游戏样式表 · 琥珀暖调主题
 * 暖米白渐变背景 + 深棕文字（复古纸感）
 * 琥珀橙渐变按钮 + 米白下拉框
 * ============================================ */

/* ---- 主窗口：暖米白渐变（暖色调放松眼感） ---- */
QWidget#SnakeGameView {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
                                stop: 0 #fdf6ec,
                                stop: 0.5 #f8ecd9,
                                stop: 1 #f0e0c6);
}

/* ---- 标签：深棕文字（暖浅底上对比清晰） ---- */
QLabel {
    color: #5c4530;
    font-size: 16px;
    font-weight: 600;
    padding: 4px;
    background: transparent;
}

/* ---- 信息卡片：暖白半透明玻璃圆角卡 ---- */
QFrame#infoCard {
    background: rgba(255, 250, 240, 0.72);
    border: 1px solid rgba(150, 110, 60, 0.22);
    border-radius: 14px;
    padding: 8px 6px;
}

/* ---- 主按钮：琥珀橙渐变（白字对比清晰） ---- */
QPushButton {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
                                stop: 0 #f2a03d,
                                stop: 1 #c97b24);
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 80);
    padding: 10px 16px;
    font-size: 18px;
    font-weight: bold;
    border-radius: 14px;
    min-width: 96px;
}

QPushButton:hover {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
                                stop: 0 #ffb357,
                                stop: 1 #d98a2e);
    border: 1px solid rgba(255, 255, 255, 140);
}

QPushButton:pressed {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
                                stop: 0 #b26a1c,
                                stop: 1 #9a5a15);
    padding-top: 12px;
    padding-bottom: 8px;
}

QPushButton:disabled {
    background: rgba(170, 140, 100, 0.40);
    color: rgba(120, 100, 70, 0.55);
    border: 1px solid rgba(150, 110, 60, 0.14);
}

/* ---- 下拉框：米白底深棕字 ---- */
QComboBox {
    background: #fffaf0;
    color: #5c4530;
    border: 1px solid rgba(150, 110, 60, 0.32);
    border-radius: 10px;
    padding: 7px 14px;
    font-size: 15px;
    min-width: 150px;
}

QComboBox:hover {
    border: 1px solid rgba(150, 110, 60, 0.55);
    background: #fffdf7;
}

QComboBox:disabled {
    color: rgba(140, 120, 90, 0.6);
    background: rgba(235, 220, 195, 0.8);
    border: 1px solid rgba(150, 110, 60, 0.12);
}

QComboBox::drop-down {
    border: none;
    width: 26px;
}

QComboBox::down-arrow {
    image: none;
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 6px solid #8a6a45;
    margin-right: 8px;
}

/* 下拉弹出列表：米白底深棕字，选中项暖棕高亮 */
QComboBox QAbstractItemView {
    background: #fffaf0;
    color: #5c4530;
    border: 1px solid rgba(150, 110, 60, 0.30);
    border-radius: 8px;
    selection-background-color: #c97b24;
    selection-color: #ffffff;
    outline: none;
    padding: 4px;
}

/* ---- 状态标签：焦糖棕醒目大字 ---- */
QLabel#stateLabel {
    font-size: 22px;
    font-weight: bold;
    color: #a35d12;
    padding: 8px 4px 10px 4px;
}

/* ---- 信息卡片内标签：深棕数值 ---- */
QFrame#infoCard QLabel {
    font-size: 17px;
    font-weight: bold;
    color: #4a3826;
    padding: 6px 4px;
}
